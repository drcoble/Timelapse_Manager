# Timelapse Manager environment for the Proxmox CT template.
#
# The service reads this file through EnvironmentFile= in its systemd unit.
# The template ships with the listener confined to loopback, so the first-run
# page is NOT reachable from the network until the operator opts in:
#
#   1. pct enter <id>
#   2. timelapse-manager setup-code        (or use the headless admin CLI)
#   3. finish setup from inside the CT (curl http://127.0.0.1:8080/ ...)
#   4. change TLM_SERVER__BIND_ADDRESS below to 0.0.0.0 (or the CT address),
#      then: systemctl restart timelapse-manager
#
# Put TLS termination (a reverse proxy) in front before exposing it.
TLM_SERVER__BIND_ADDRESS=127.0.0.1
